{
  "name": "machinal-web",
  "private": true,
  "version": "0.0.1-next.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "dev:gallery": "vite --host 127.0.0.1 --open /native-gallery.html",
    "build": "vite build",
    "icons:generate": "node scripts/generate-brand-icons.mjs",
    "sync:catalog": "node scripts/sync-catalog.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "report:effects": "node scripts/report-effects.mjs",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.1.2",
    "jsdom": "^29.1.1",
    "svelte": "^5.15.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/merriweather": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/open-sans": "^5.3.0",
    "@fontsource-variable/oswald": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@machinal/scenes": "0.1.1",
    "gsap": "3.14.2",
    "pixi.js": "^8.6.5",
    "svelte-pixi": "^8.0.1",
    "svelte-wayfind": "^1.2.0",
    "yaml": "^2.8.1"
  }
}
